{% extends 'base.html.twig' %}

{% block title %}{{ parametres.menu_donation }} · {{ parent() }}{% endblock %}
{% block meta_description %}Soutenez l'AG35 : vos dons financent l'accueil des étudiant·es, l'entraide et les événements culturels guinéens à Rennes.{% endblock %}

{% block body %}
	{% include 'components/page_hero.html.twig' with {
		title: 'Soutenir l\'AG35',
		eyebrow: parametres.menu_donation,
		lead: 'Chaque don, même modeste, nous aide à accueillir, accompagner et rassembler la communauté guinéenne d\'Ille-et-Vilaine.'
	} %}

	<section class="section">
		<div class="container">
			<div class="row g-5 align-items-start">
				<div class="col-lg-7">
					<span class="eyebrow">À quoi sert votre don ?</span>
					<h2 class="section-title">Des actions concrètes, toute l'année</h2>
					<p class="section-lead mb-4">L'association fonctionne grâce à l'engagement de ses bénévoles et au soutien de ses membres et donateurs. Votre contribution sert directement nos actions sur le terrain.</p>

					<div class="row g-4">
						<div class="col-md-6">
							<article class="card-ag">
								<span class="service-icon mb-3"><i class="fa fa-home" aria-hidden="true"></i></span>
								<h3>Accueil et logement</h3>
								<p class="text-muted-ag">Hébergement temporaire et accompagnement des nouveaux étudiant·es à leur arrivée.</p>
							</article>
						</div>
						<div class="col-md-6">
							<article class="card-ag">
								<span class="service-icon mb-3"><i class="fa fa-hands-helping" aria-hidden="true"></i></span>
								<h3>Entraide et solidarité</h3>
								<p class="text-muted-ag">Aide ponctuelle aux membres en difficulté et soutien dans les démarches administratives.</p>
							</article>
						</div>
						<div class="col-md-6">
							<article class="card-ag">
								<span class="service-icon mb-3"><i class="fa fa-music" aria-hidden="true"></i></span>
								<h3>Culture et événements</h3>
								<p class="text-muted-ag">Fêtes, rencontres et temps forts qui font vivre la culture guinéenne à Rennes.</p>
							</article>
						</div>
						<div class="col-md-6">
							<article class="card-ag">
								<span class="service-icon mb-3"><i class="fa fa-graduation-cap" aria-hidden="true"></i></span>
								<h3>Orientation</h3>
								<p class="text-muted-ag">Conseils pour les études, les stages et l'insertion professionnelle.</p>
							</article>
						</div>
					</div>
				</div>

				<div class="col-lg-5">
					<div class="form-card">
						<h2 class="h4 mb-4">Comment faire un don ?</h2>
						<ol class="steps mb-4">
							<li><div><strong>Choisissez votre montant</strong><span>sur notre page HelloAsso, don ponctuel ou régulier.</span></div></li>
							<li><div><strong>Payez en ligne</strong><span>par carte bancaire, de façon 100 % sécurisée.</span></div></li>
							<li><div><strong>Recevez votre reçu</strong><span>une confirmation vous est envoyée par e-mail.</span></div></li>
						</ol>
						<a class="btn btn-ag-yellow w-100" href="{{ lien_don }}" target="_blank" rel="noopener">
							<i class="fa fa-heart me-1" aria-hidden="true"></i> Faire un don sur HelloAsso
						</a>
						<p class="small text-muted-ag text-center mt-3 mb-0"><i class="fa fa-lock me-1" aria-hidden="true"></i> Paiement sécurisé par HelloAsso</p>
					</div>

					<div class="card-ag mt-4">
						<h3>Envie d'aller plus loin ?</h3>
						<p class="text-muted-ag">Vous pouvez aussi devenir membre ou donner un peu de votre temps comme bénévole.</p>
						<div class="d-flex flex-wrap gap-3">
							<a class="link-arrow" href="{{ path('app_adhesion') }}">{{ parametres.menu_adhesion }} <i class="fa fa-arrow-right" aria-hidden="true"></i></a>
							<a class="link-arrow" href="{{ path('app_volontariat') }}">{{ parametres.menu_volontariat }} <i class="fa fa-arrow-right" aria-hidden="true"></i></a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
{% endblock %}
