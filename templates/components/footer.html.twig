<!-- Footer Start -->

<div class="container-fluid bg-dark footer mt-5 py-5 wow fadeIn" data-wow-delay="0.1s">

	<div class="container py-5">

		<div class="row g-5">

			<div class="col-lg-3 col-md-6">

				<h4 class="text-white mb-4">Notre bureau</h4>

				<p class="mb-2">

					<i class="fa fa-map-marker-alt me-3"></i>
					{{ parametres.address }}</p>

				<p class="mb-2">

					<i class="fa fa-phone-alt me-3"></i>
					{{ parametres.telephone }}</p>

				<p class="mb-2">

					<i class="fa fa-envelope me-3"></i>
					{{ parametres.email }}</p>

				<div class="d-flex pt-3">

					<a class="btn btn-square btn-primary rounded-circle me-2" href="{{ parametres.lien_page_fb }}">

						<i class="fab fa-facebook-f"></i>

					</a>

					<a class="btn btn-success rounded-circle me-2" href="{{ parametres.lien_whatsApp }}">
						<i class="fab fa-whatsapp"></i>
					</a>

					<a class="btn btn-square btn-danger rounded-circle me-2" href="">

						<i class="fab fa-youtube"></i>

					</a>

					<a class="btn btn-square btn-primary rounded-circle me-2" href="">

						<i class="fab fa-linkedin-in"></i>

					</a>

				</div>

			</div>

			<div class="col-lg-3 col-md-6">

				<h4 class="text-white mb-4">Liens rapides</h4>

				<a class="btn btn-link" href="/about">{{parametres.menu_apropos }}</a>

				<a class="btn btn-link" href="/evenements">{{ parametres.menu_evenement }}</a>

				<a class="btn btn-link" href="/actualites">{{ parametres.menu_actualite }}</a>

				<a class="btn btn-link" href="/guide">{{ parametres.menu_guide }}</a>

				<a class="btn btn-link" href="{{ parametres.lien_donation }}" target=" _blank">{{ parametres.menu_donation }}</a>

				<a class="btn btn-link" href="/adhesion">{{ parametres.menu_adhesion }}</a>

				<a class="btn btn-link" href="/contact">{{ parametres.menu_contact }}</a>

			</div>

			<div class="col-lg-3 col-md-6">

				<h4 class="text-white mb-4">Heures de travail</h4>

				<p class="mb-1">Lundi - Vendredi</p>

				<h6 class="text-light">09:00  - 18:00

				</h6>

				<p class="mb-1">Samedi</p>

				<h6 class="text-light">14:00 - 18:00

				</h6>

				<p class="mb-1">Dimanche</p>

				<h6 class="text-light">Fermé</h6>

			</div>

			<div class="col-lg-3 col-md-6">
				<h4 class="text-white mb-4">Newsletter</h4>
				<p>Restez informé(e) des dernières nouvelles et des événements à venir de notre association !</p>
				<div class="position-relative w-100">
					{# Affichage des messages de succès #}
					{% for message in app.flashes('success') %}
						<div class="alert alert-success" role="alert">
							{{ message }}
						</div>
					{% endfor %}
				
					{# Affichage des messages d'erreur #}
					{% for message in app.flashes('error') %}
						<div class="alert alert-danger" role="alert">
							{{ message }}
						</div>
					{% endfor %}
				
					<!-- Formulaire avec champ pour l'email seulement -->
					<form action="{{ path('inscription_newsletter') }}" method="POST" id="newsletterForm">
						<!-- Champs pour l'email -->
						<input class="form-control bg-transparent w-100 py-3 ps-4 pe-5" type="email" name="email" placeholder="Votre email" required>
						
						<!-- Champs pour le prénom (caché) -->
						<input id="modalFirstName" type="hidden" name="modalFirstName">
						<!-- Champs pour le nom de famille (caché) -->
						<input id="modalLastName" type="hidden" name="modalLastName">
						
						<button type="button" class="btn btn-light py-2 position-absolute top-0 end-0 mt-2 me-2" onclick="afficherFenetreModale()">S'inscrire</button>
					</form>
					
				</div>
			</div>
			
			<!-- Fenêtre modale pour saisir le nom et le prénom -->
			<div id="modal" class="modal">
				<div class="modal-content">
					<span class="close" onclick="fermerFenetreModale()">&times;</span>
					<h2 style="color: white;">Saisir le nom et le prénom</h2>
					<div style="margin: 20px;">
						<!-- Champs pour le prénom -->
						<input id="firstName" type="text" placeholder="Votre prénom" style="width: 100%; padding: 10px; margin-bottom: 10px;">
						<!-- Champs pour le nom de famille -->
						<input id="lastName" type="text" placeholder="Votre nom de famille" style="width: 100%; padding: 10px; margin-bottom: 10px;">
						<!-- Bouton pour valider -->
						<button id="submitNameBtn" onclick="validerNomPrenom()" style="background-color: green; color: white; border: none; padding: 10px 20px; cursor: pointer;">Valider</button>
					</div>
				</div>
			</div>

		</div>

	</div>

</div>

<!-- Footer End -->


