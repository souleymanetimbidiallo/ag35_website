{% set lien_don = parametres.lien_donation|default('https://www.helloasso.com/associations/association-guineenne-d-ile-et-vilaine-ag35/formulaires/1') %}

<footer class="site-footer">
	<div class="tricolor" aria-hidden="true"></div>
	<div class="container footer-main">
		<div class="row g-5">
			<div class="col-lg-4 col-md-6">
				<a href="{{ path('app_accueil') }}" class="brand">
					<img src="{{ asset('img/logo_ag35.png') }}" alt="" width="48" height="48">
					<span class="brand-text">
						<span class="brand-name">{{ parametres.site_name|default('AG35') }}</span>
						<span class="brand-sub">Guinéen·nes d'Ille-et-Vilaine</span>
					</span>
				</a>
				<p class="mb-4">{{ parametres.nom_association }} : entraide, accueil des étudiant·es et vie culturelle guinéenne à Rennes et en Ille-et-Vilaine.</p>
				<div class="socials">
					{% if parametres.lien_page_fb %}
						<a href="{{ parametres.lien_page_fb }}" target="_blank" rel="noopener" aria-label="Page Facebook"><i class="fab fa-facebook-f" aria-hidden="true"></i></a>
					{% endif %}
					{% if parametres.lien_groupe_fb %}
						<a href="{{ parametres.lien_groupe_fb }}" target="_blank" rel="noopener" aria-label="Groupe Facebook"><i class="fas fa-users" aria-hidden="true"></i></a>
					{% endif %}
					{% if parametres.lien_whatsApp %}
						<a href="{{ parametres.lien_whatsApp }}" target="_blank" rel="noopener" aria-label="Groupe WhatsApp"><i class="fab fa-whatsapp" aria-hidden="true"></i></a>
					{% endif %}
				</div>
			</div>

			<div class="col-lg-2 col-md-6">
				<h2>Liens rapides</h2>
				<ul class="footer-links">
					<li><a href="{{ path('app_about') }}">{{ parametres.menu_apropos }}</a></li>
					<li><a href="{{ path('app_evenements') }}">{{ parametres.menu_evenement }}</a></li>
					<li><a href="{{ path('app_actualites') }}">{{ parametres.menu_actualite }}</a></li>
					<li><a href="{{ path('app_guide') }}">{{ parametres.menu_guide }}</a></li>
					<li><a href="{{ path('app_adhesion') }}">{{ parametres.menu_adhesion }}</a></li>
					<li><a href="{{ lien_don }}" target="_blank" rel="noopener">{{ parametres.menu_donation }}</a></li>
					<li><a href="{{ path('app_contact') }}">{{ parametres.menu_contact }}</a></li>
				</ul>
			</div>

			<div class="col-lg-3 col-md-6">
				<h2>Nous contacter</h2>
				<ul class="footer-contact">
					{% if parametres.address %}
						<li><i class="fa fa-map-marker-alt" aria-hidden="true"></i><span>{{ parametres.address }}</span></li>
					{% endif %}
					{% if parametres.telephone %}
						<li><i class="fa fa-phone-alt" aria-hidden="true"></i><a href="tel:{{ parametres.telephone|replace({' ': ''}) }}">{{ parametres.telephone }}</a></li>
					{% endif %}
					{% if parametres.email %}
						<li><i class="fa fa-envelope" aria-hidden="true"></i><a href="mailto:{{ parametres.email }}">{{ parametres.email }}</a></li>
					{% endif %}
					<li><i class="fa fa-clock" aria-hidden="true"></i><span>Lun–ven 9h–18h · Sam 14h–18h</span></li>
				</ul>
			</div>

			<div class="col-lg-3 col-md-6">
				<h2>Newsletter</h2>
				<p>Recevez nos actualités et les prochains événements de l'association.</p>

				{% for message in app.flashes('success') %}
					<div class="alert alert-success" role="status">{{ message }}</div>
				{% endfor %}
				{% for message in app.flashes('error') %}
					<div class="alert alert-danger" role="alert">{{ message }}</div>
				{% endfor %}

				<form class="newsletter-form" id="newsletterForm" action="{{ path('inscription_newsletter') }}" method="POST">
					<label for="newsletterEmail" class="visually-hidden">Votre email</label>
					<input class="form-control" id="newsletterEmail" type="email" name="email" placeholder="Votre email" autocomplete="email" required>
					<input type="hidden" name="modalFirstName" id="modalFirstName">
					<input type="hidden" name="modalLastName" id="modalLastName">
					<button type="submit" class="btn btn-ag-yellow">S'inscrire</button>
				</form>
			</div>
		</div>
	</div>

	<div class="footer-bottom">
		<div class="container d-flex flex-column flex-md-row justify-content-between gap-2 text-center text-md-start">
			<span>&copy; {{ 'now'|date('Y') }} {{ parametres.nom_association }}. Tous droits réservés.</span>
			<span>Thème de base : <a href="https://htmlcodex.com" target="_blank" rel="noopener">HTML Codex</a></span>
		</div>
	</div>
</footer>

<!-- Newsletter : demande du prénom et du nom avant l'envoi -->
<div class="modal fade" id="newsletterModal" tabindex="-1" aria-labelledby="newsletterModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h2 class="modal-title h4" id="newsletterModalLabel">Encore une étape</h2>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
			</div>
			<form class="modal-body" id="newsletterNameForm">
				<p class="text-muted">Indiquez votre prénom et votre nom pour finaliser l'inscription.</p>
				<div class="mb-3">
					<label for="nlFirstName" class="form-label">Prénom</label>
					<input id="nlFirstName" type="text" class="form-control" autocomplete="given-name" required>
				</div>
				<div class="mb-4">
					<label for="nlLastName" class="form-label">Nom</label>
					<input id="nlLastName" type="text" class="form-control" autocomplete="family-name" required>
				</div>
				<button type="submit" class="btn btn-primary w-100">Valider mon inscription</button>
			</form>
		</div>
	</div>
</div>

<script>
	document.addEventListener('DOMContentLoaded', function () {
		var form = document.getElementById('newsletterForm');
		var nameForm = document.getElementById('newsletterNameForm');
		var modalEl = document.getElementById('newsletterModal');
		if (!form || !nameForm || !modalEl || typeof bootstrap === 'undefined') { return; }
		var modal = new bootstrap.Modal(modalEl);

		form.addEventListener('submit', function (e) {
			if (!form.elements.modalFirstName.value || !form.elements.modalLastName.value) {
				e.preventDefault();
				modal.show();
			}
		});
		modalEl.addEventListener('shown.bs.modal', function () {
			document.getElementById('nlFirstName').focus();
		});
		nameForm.addEventListener('submit', function (e) {
			e.preventDefault();
			form.elements.modalFirstName.value = document.getElementById('nlFirstName').value.trim();
			form.elements.modalLastName.value = document.getElementById('nlLastName').value.trim();
			if (form.elements.modalFirstName.value && form.elements.modalLastName.value) {
				form.submit();
			}
		});
	});
</script>
