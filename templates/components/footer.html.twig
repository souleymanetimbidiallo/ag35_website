<!-- Back to Top -->

<a href="#" class="btn btn-lg btn-primary btn-lg-square rounded-circle back-to-top">

	<i class="bi bi-arrow-up"></i>

</a>
<script>
	// Fonction pour afficher la fenêtre modale
	function afficherFenetreModale() {
		var modal = document.getElementById('modal');
		modal.style.display = "block";
	}

	// Fonction pour fermer la fenêtre modale
	function fermerFenetreModale() {
		var modal = document.getElementById('modal');
		modal.style.display = "none";
	}

	// Fonction pour valider le nom et le prénom et soumettre le formulaire
	function validerNomPrenom() {
		// Récupérer les valeurs du nom et du prénom saisies par l'utilisateur
		var firstName = document.getElementById("firstName").value.trim();
		var lastName = document.getElementById("lastName").value.trim();
		
		// Vérifier si les champs de nom et de prénom sont vides
		if (!firstName || !lastName) {
			alert("Veuillez saisir votre nom et votre prénom.");
			return;
		}
		
		// Affecter les valeurs du nom et du prénom aux champs cachés correspondants dans le formulaire principal
		document.getElementById("newsletterForm").elements.namedItem("modalFirstName").value = firstName;
		document.getElementById("newsletterForm").elements.namedItem("modalLastName").value = lastName;
		
		
		// Soumettre le formulaire principal
		document.getElementById("newsletterForm").submit();
	}
	
</script>

<!-- Styles CSS pour la fenêtre modale -->
<style>
    .modal {
        display: none;
        position: fixed;
        z-index: 1;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.5);
    }

    .modal-content {
        background-color: #333;
        margin: 15% auto;
        padding: 20px;
        border: 1px solid #888;
        width: 40%;
        max-width: 400px;
        border-radius: 10px;
        box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2), 0 6px 20px 0 rgba(0, 0, 0, 0.19);
    }

    .close {
        color: red;
        float: right;
        font-size: 28px;
        font-weight: bold;
    }

    .close:hover,
    .close:focus {
        color: #ccc;
        text-decoration: none;
        cursor: pointer;
    }
</style>
