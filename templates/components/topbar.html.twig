<!-- Topbar Start -->
<div class="container-fluid bg-primary text-white py-3">
    <div class="container d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <a href="/" class="d-flex align-items-center">
                <img src="/img/logo_ag35.png" alt="Logo" style="height: 50px; margin-right: 10px;">
                {% if parametres.site_name %}
                    <h2 class="text-white fw-bold m-0">{{ parametres.site_name }}</h2>
                {% endif %}
            </a>
        </div>
        <div class="d-flex align-items-center">
            <small class="ms-4 text-truncate" style="max-width: 350px;">
                {{ parametres.address }}
            </small>

            <small class="ms-3 text-truncate" style="max-width: 250px;">
                <i class="fa fa-envelope me-2"></i>
                <a class="text-light" href="mailto:{{ parametres.email }}">{{ parametres.email }}</a>
            </small>

            <small class="ms-3">
                <i class="fa fa-phone-alt me-2"></i>
                <a class="text-light" href="tel:{{ parametres.telephone }}">{{ parametres.telephone }}</a>
            </small>

            <div class="ms-3 d-flex align-items-center">
                <a class="btn btn-sm-square btn-light text-primary rounded-circle ms-1" href="{{ parametres.lien_page_fb }}" target="_blank">
                    <i class="fab fa-facebook-f"></i>
                </a>
                <span class="ms-1 mb-0 text-white">Page</span>
                
                <a class="btn btn-sm-square btn-light text-primary rounded-circle ms-1" href="{{ parametres.lien_groupe_fb }}" target="_blank">
                    <i class="fab fa-facebook-f"></i>
                </a>
                <span class="ms-1 mb-0 text-white">Groupe</span>
                
                <a class="btn btn-sm-square btn-success rounded-circle ms-1" href="{{ parametres.lien_whatsApp }}" target="_blank">
                    <i class="fab fa-whatsapp"></i>
                </a>
                <span class="ms-1 mb-0 text-white">Groupe Public</span>
            </div>
        </div>
    </div>
</div>
<!-- Topbar End -->
