{% extends 'base.html.twig' %}

{% block title %}Hello Asso Data{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-4">Informations sur les donations et les adhésions</h1>
    {% if is_granted('ROLE_ADMIN') %}
        <h2 class="mb-3">Donations</h2>
        <div class="table-responsive">
            <table class="table table-striped table-hover table-sm","table table-bordered">
                <thead class="thead-dark">
                    <tr>
                        <th scope="col">Order Id</th>
                        <th scope="col">Date</th>
                        <th scope="col">Amount</th>
                        <th scope="col">Payer</th>
                        <th scope="col">Email</th>
                        <th scope="col">Address</th>
                    </tr>
                </thead>
                <tbody>
                    {% for donation in donations.data %}
                        <tr>
                            <td>{{ donation.order.id }}</td>
                            <td>{{ donation.order.date }}</td>
                            <td>{{ donation.amount }}</td>
                            <td>{{ donation.payer.firstName }} {{ donation.payer.lastName }}</td>
                            <td>{{ donation.payer.email }}</td>
                            <td>{{ donation.payer.address }}, {{ donation.payer.city }} {{ donation.payer.zipCode }}, {{ donation.payer.country }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <h2 class="mb-3">Adhesions</h2>
        {% if adhesion.data is defined and adhesion.data|length > 0 %}
            <div class="table-responsive">
                <table class="table table-striped table-hover table-sm","table table-bordered">
                    <thead class="thead-dark">
                        <tr>
                            <th scope="col">Order Id</th>
                            <th scope="col">Date</th>
                            <th scope="col">Amount</th>
                            <th scope="col">type</th>
                            <th scope="col">Payer</th>
                            <th scope="col">Email</th>
                            </tr>
                    </thead>
                    <tbody>
                        {% for adhesion in adhesion.data %}
                            <tr>
                                <td>{{ adhesion.order.id }}</td>
                                <td>{{ adhesion.order.date }}</td>
                                <td>{{ adhesion.amount }}</td>
                                <td>{{ adhesion.type }}</td>
                                <td>{{ adhesion.payer.firstName }} {{ adhesion.payer.lastName }}</td>
                                <td>{{ adhesion.payer.email }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p>No adhesions found.</p>
        {% endif %}
        {% else %}
        <p>You do not have access to this page. please log in </p>
    {% endif %}
    </div>
{% endblock %}
