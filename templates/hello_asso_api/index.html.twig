{% extends 'base.html.twig' %}

{% block title %}Données HelloAsso · {{ parent() }}{% endblock %}

{% block meta_tags %}
    <meta name="robots" content="noindex">
{% endblock %}

{% block body %}
    {% include 'components/page_hero.html.twig' with {
        title: 'Dons et adhésions',
        eyebrow: 'Administration',
        lead: 'Données synchronisées depuis HelloAsso.'
    } %}

    <section class="section">
    <div class="container">
    {% if is_granted('ROLE_ADMIN') %}
        <div class="form-card mb-5">
        <h2 class="h4 mb-3">Dons</h2>
        {% if donations.data is defined and donations.data|length > 0 %}
        <div class="table-responsive">
            <table class="table table-striped table-hover table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Commande</th>
                        <th scope="col">Date</th>
                        <th scope="col">Montant</th>
                        <th scope="col">Donateur</th>
                        <th scope="col">E-mail</th>
                        <th scope="col">Adresse</th>
                    </tr>
                </thead>
                <tbody>
                    {% for donation in donations.data %}
                        <tr>
                            <td>{{ donation.order.id }}</td>
                            <td>{{ donation.order.date|date('d/m/Y H:i') }}</td>
                            <td>{{ donation.amount / 100 }} €</td>
                            <td>{{ donation.payer.firstName }} {{ donation.payer.lastName }}</td>
                            <td>{{ donation.payer.email }}</td>
                            <td>{{ donation.payer.address|default('') }}, {{ donation.payer.city|default('') }} {{ donation.payer.zipCode|default('') }}, {{ donation.payer.country|default('') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
            <p class="text-muted-ag mb-0">Aucun don trouvé.</p>
        {% endif %}
        </div>

        <div class="form-card">
        <h2 class="h4 mb-3">Adhésions</h2>
        {% if adhesion.data is defined and adhesion.data|length > 0 %}
            <div class="table-responsive">
                <table class="table table-striped table-hover table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Commande</th>
                            <th scope="col">Date</th>
                            <th scope="col">Montant</th>
                            <th scope="col">Type</th>
                            <th scope="col">Adhérent·e</th>
                            <th scope="col">E-mail</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for adhesion in adhesion.data %}
                            <tr>
                                <td>{{ adhesion.order.id }}</td>
                                <td>{{ adhesion.order.date|date('d/m/Y H:i') }}</td>
                                <td>{{ adhesion.amount / 100 }} €</td>
                                <td>{{ adhesion.type }}</td>
                                <td>{{ adhesion.payer.firstName }} {{ adhesion.payer.lastName }}</td>
                                <td>{{ adhesion.payer.email }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="text-muted-ag mb-0">Aucune adhésion trouvée.</p>
        {% endif %}
        </div>

        <p class="mt-4 mb-0"><a class="link-arrow" href="{{ path('admin') }}"><i class="fa fa-arrow-left" aria-hidden="true"></i> Retour à l'administration</a></p>
    {% else %}
        <div class="empty-state">
            <i class="fa fa-lock" aria-hidden="true"></i>
            <p class="mb-3">Vous n'avez pas accès à cette page.</p>
            <a class="btn btn-primary" href="{{ path('app_login') }}">Se connecter</a>
        </div>
    {% endif %}
    </div>
    </section>
{% endblock %}
