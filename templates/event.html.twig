{% extends 'base.html.twig' %}

{% block title %}Événements · {{ parent() }}{% endblock %}

{% block body %}
	{% include 'components/page_hero.html.twig' with {
		title: parametres.menu_evenement|default('Événements'),
		eyebrow: 'Agenda',
		lead: 'Journées culturelles, soirées solidaires, assemblées générales… Retrouvez tous les rendez-vous de l\'AG35.'
	} %}

	{% set maintenant = 'now'|date('U') %}
	{% set a_venir = evenements_a_venir|default([])|sort((a, b) => a.dateDebut <=> b.dateDebut) %}
	{% set passes = tous_les_evenements|default([])|filter(e => e.dateDebut and e.dateDebut|date('U') < maintenant)|sort((a, b) => b.dateDebut <=> a.dateDebut) %}

	<section class="section" aria-labelledby="titre-a-venir">
		<div class="container">
			<div class="section-head">
				<span class="badge-ag upcoming mb-3"><i class="fa fa-calendar-alt" aria-hidden="true"></i> Prochainement</span>
				<h2 class="section-title" id="titre-a-venir">Événements à venir</h2>
			</div>
			{% if a_venir|length > 0 %}
				<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
					{% for evenement in a_venir %}
						<div class="col">{% include 'components/event_card.html.twig' %}</div>
					{% endfor %}
				</div>
			{% else %}
				<div class="empty-state">
					<i class="fa fa-calendar" aria-hidden="true"></i>
					<p class="mb-3">Aucun événement n'est programmé pour le moment.</p>
					<p class="mb-0">Suivez-nous sur
						{% if parametres.lien_page_fb %}<a href="{{ parametres.lien_page_fb }}" target="_blank" rel="noopener">Facebook</a>{% else %}Facebook{% endif %}
						pour être informé·e des prochaines dates.</p>
				</div>
			{% endif %}
		</div>
	</section>

	{% if passes|length > 0 %}
		<section class="section section-white" aria-labelledby="titre-passes">
			<div class="container">
				<div class="section-head">
					<span class="badge-ag past mb-3"><i class="fa fa-history" aria-hidden="true"></i> Archives</span>
					<h2 class="section-title" id="titre-passes">Événements passés</h2>
				</div>
				<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
					{% for evenement in passes %}
						<div class="col">{% include 'components/event_card.html.twig' %}</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}
{% endblock %}
