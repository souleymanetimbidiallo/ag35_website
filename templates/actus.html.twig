{% extends 'base.html.twig' %}

{% set mois = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'] %}

{% block title %}Actualités · {{ parent() }}{% endblock %}

{% block body %}
	{% include 'components/page_hero.html.twig' with {
		title: parametres.menu_actualite|default('Actualités'),
		eyebrow: 'La vie de l\'association',
		lead: parametres.texte_actu|default('')|striptags|trim ?: 'Projets, temps forts et nouvelles de l\'AG35.'
	} %}

	<section class="section">
		<div class="container">
			{% set liste = actualites|default([])|sort((a, b) => b.datePublication <=> a.datePublication) %}
			{% if liste|length > 0 %}
				<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
					{% for actualite in liste %}
						<div class="col">
							<article class="news-card">
								<div class="news-media">
									{% if actualite.imageName %}
										<img src="{{ asset('img/' ~ actualite.imageName) }}" alt="" loading="lazy" onerror="this.remove()">
									{% endif %}
								</div>
								<div class="news-body">
									{% if actualite.datePublication %}
										<time class="news-date" datetime="{{ actualite.datePublication|date('Y-m-d') }}">
											{{ actualite.datePublication|date('j') }} {{ mois[actualite.datePublication|date('n') - 1] }} {{ actualite.datePublication|date('Y') }}
										</time>
									{% endif %}
									<h2>{{ actualite.titre }}</h2>
									<p>{{ actualite.description|striptags }}</p>
									{% if parametres.lien_actualite %}
										<a href="{{ parametres.lien_actualite }}" class="link-arrow mt-auto pt-2" target="_blank" rel="noopener">Lire la suite <i class="fa fa-arrow-right" aria-hidden="true"></i></a>
									{% endif %}
								</div>
							</article>
						</div>
					{% endfor %}
				</div>
			{% else %}
				<div class="empty-state">
					<i class="fa fa-newspaper" aria-hidden="true"></i>
					<p class="mb-0">Aucune actualité pour le moment. Revenez bientôt !</p>
				</div>
			{% endif %}
		</div>
	</section>
{% endblock %}
