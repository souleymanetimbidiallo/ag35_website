{% extends 'base.html.twig' %}

{% block body %}
	<!-- Page Header Start -->
	<div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s">
		<div class="container text-center py-5">
			<h1 class="display-2 text-white mb-4 animated slideInDown">Actualités</h1>
		</div>
	</div>
	<!-- Page Header End -->

	<!-- Project Start -->
	<div class="container-xxl pt-5">
		<div class="container">
			<h7>
				{{ parametres.texte_actu }}

			</h7>
			<div class="text-center text-md-start pb-5 pb-md-0 wow fadeInUp" style="max-width: 500px;">
				<p class="fs-5 fw-medium text-primary">Les actualités</p>
				<h1 class="display-5 mb-5">Actualités et Projets de l'Association AG35</h1>
			</div>
			<div class="owl-carousel project-carousel" data-loop="false">
				{% for actualite in actualites %}
					<div class="project-item mb-5">
						<div class="position-relative">
							<img class="img-fluid" src="{{ asset('img/ag35/' ~ actualite.imageName) }}" alt="Image">
							<div class="project-overlay">
								<a class="btn btn-lg-square btn-light rounded-circle m-1" href="{{ parametres.lien_actualite }}">
									<i class="fa fa-eye"></i>
								</a>
							</div>
						</div>
						<div class="p-4">
							<a class="d-block h5" href="">{{ actualite.titre }}</a>

							<a class="d-block h7" href="">{{ actualite.description }}</a>
						</div>
					</div>
				{% endfor %}
			</div>
		</div>
	</div>


	<!-- Project End -->
{% endblock %}
