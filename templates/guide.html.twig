{% extends 'base.html.twig' %}

{% block title %}Guide · {{ parent() }}{% endblock %}

{% block body %}
	{% include 'components/page_hero.html.twig' with {
		title: parametres.menu_guide|default('Guide'),
		eyebrow: 'Ressources',
		lead: 'Nos guides pratiques pour préparer votre arrivée et faciliter votre vie en Ille-et-Vilaine.'
	} %}

	<section class="section">
		<div class="container">
			<div class="row g-5">
				<div class="col-lg-5">
					<span class="eyebrow">À télécharger</span>
					<h2 class="section-title">Bien préparer son arrivée</h2>
					{% set texte = parametres.texte_guide|default('')|striptags|trim %}
					<p class="section-lead">{{ texte ?: 'Logement, démarches, santé, transports : retrouvez l\'essentiel dans nos documents, mis à jour par les bénévoles de l\'association.' }}</p>
					<p class="mt-4 mb-0">Une question qui n'y figure pas ?
						<a href="{{ path('app_contact') }}" class="fw-bold">Écrivez-nous</a>.</p>
				</div>
				<div class="col-lg-7">
					{% set docs = [] %}
					{% for guide in guides %}
						{% set pdfPath = 'pdf/' ~ guide.pdfName %}
						{% if guide.pdfName and (app.request.server.get('DOCUMENT_ROOT') ~ asset(pdfPath))|file_exists %}
							{% set docs = docs|merge([guide]) %}
						{% endif %}
					{% endfor %}

					{% if docs|length > 0 %}
						<div class="d-grid gap-3">
							{% for guide in docs %}
								{% set nom = guide.pdfName|replace({'.pdf': '', '-': ' ', '_': ' '})|capitalize %}
								<div class="card-ag doc-card">
									<span class="doc-icon"><i class="fa fa-file-pdf" aria-hidden="true"></i></span>
									<div class="flex-grow-1">
										<h3>{{ nom }}</h3>
										<span class="text-muted-ag small">Document PDF</span>
									</div>
									<a class="btn btn-primary" href="{{ asset('pdf/' ~ guide.pdfName) }}" target="_blank" rel="noopener" download>
										<i class="fa fa-download me-1" aria-hidden="true"></i> Télécharger
									</a>
								</div>
							{% endfor %}
						</div>
					{% else %}
						<div class="empty-state">
							<i class="fa fa-book-open" aria-hidden="true"></i>
							<p class="mb-0">Les guides seront bientôt disponibles.</p>
						</div>
					{% endif %}
				</div>
			</div>
		</div>
	</section>
{% endblock %}
