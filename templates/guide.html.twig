{% extends 'base.html.twig' %}

{% block title %}Guide de l'étudiant · {{ parent() }}{% endblock %}
{% block meta_description %}Le guide de l'AG35 pour bien arriver à Rennes : les étapes clés de l'installation et nos livrets à télécharger.{% endblock %}

{% set etapes = [
	{titre: 'Valider son visa', texte: 'Dans les 3 mois suivant l\'arrivée, sur le site de l\'ANEF.', icone: 'fa-passport'},
	{titre: 'Trouver un logement', texte: 'Crous, résidence ou colocation ; hébergement temporaire possible avec l\'AG35.', icone: 'fa-home'},
	{titre: 'S\'inscrire à la Sécurité sociale', texte: 'Gratuitement, sur le site ameli dédié aux étudiant·es étranger·es.', icone: 'fa-heartbeat'},
	{titre: 'Ouvrir un compte bancaire', texte: 'Indispensable pour la CAF, le loyer et un job étudiant.', icone: 'fa-university'},
	{titre: 'Demander l\'aide au logement', texte: 'Sur caf.fr, dès l\'entrée dans le logement.', icone: 'fa-hand-holding-usd'}
] %}

{% block body %}
	{% include 'components/page_hero.html.twig' with {
		title: 'Guide de l\'étudiant',
		eyebrow: 'Nouveaux arrivants',
		lead: 'Tout ce qu\'il faut savoir pour bien arriver à Rennes : les étapes clés, nos livrets à télécharger et les réponses à vos questions.'
	} %}

	<section class="section">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">Votre arrivée</span>
				<h2 class="section-title">Les 5 étapes de votre installation</h2>
				<p class="section-lead">Dans cet ordre, autant que possible : chaque étape facilite la suivante.</p>
			</div>
			<ol class="guide-steps">
				{% for e in etapes %}
					<li class="card-ag">
						<span class="guide-step-num" aria-hidden="true">{{ loop.index }}</span>
						<span class="service-icon mb-3"><i class="fa {{ e.icone }}" aria-hidden="true"></i></span>
						<h3>{{ e.titre }}</h3>
						<p class="text-muted-ag">{{ e.texte }}</p>
					</li>
				{% endfor %}
			</ol>
			<p class="mt-4 mb-0"><a class="link-arrow" href="{{ path('app_faq') }}">Le détail de chaque démarche dans la FAQ <i class="fa fa-arrow-right" aria-hidden="true"></i></a></p>
		</div>
	</section>

	<section class="section section-white">
		<div class="container">
			<div class="row g-5">
				<div class="col-lg-5">
					<span class="eyebrow">À télécharger</span>
					<h2 class="section-title">Nos livrets</h2>
					{% set texte = parametres.texte_guide|default('')|striptags|trim %}
					<p class="section-lead">{{ texte ?: 'Logement, démarches, santé, transports : retrouvez l\'essentiel dans nos documents, mis à jour par les bénévoles de l\'association.' }}</p>
				</div>
				<div class="col-lg-7">
					{% set docs = [] %}
					{% for guide in guides %}
						{% if guide.pdfName and (app.request.server.get('DOCUMENT_ROOT') ~ asset('pdf/' ~ guide.pdfName))|file_exists %}
							{% set docs = docs|merge([guide]) %}
						{% endif %}
					{% endfor %}

					{% if docs|length > 0 %}
						<div class="d-grid gap-3">
							{% for guide in docs %}
								{# Nom affiché : nom du fichier sans extension ni suffixe unique ajouté à l'upload (ex. « -6655f0a1b2c3d ») #}
								{% set base = guide.pdfName|replace({'.pdf': '', '.PDF': ''}) %}
								{% set morceaux = base|split('-') %}
								{% if morceaux|length > 1 and morceaux|last matches '/^[0-9a-f]{13,}$/' %}
									{% set base = morceaux|slice(0, -1)|join('-') %}
								{% endif %}
								<div class="card-ag doc-card">
									<span class="doc-icon"><i class="fa fa-file-pdf" aria-hidden="true"></i></span>
									<div class="flex-grow-1">
										<h3>{{ base|replace({'-': ' ', '_': ' '})|capitalize }}</h3>
										<span class="text-muted-ag small">Document PDF</span>
									</div>
									<a class="btn btn-primary" href="{{ asset('pdf/' ~ guide.pdfName) }}" target="_blank" rel="noopener" download>
										<i class="fa fa-download me-1" aria-hidden="true"></i> Télécharger
									</a>
								</div>
							{% endfor %}
						</div>
					{% else %}
						<div class="empty-state">
							<i class="fa fa-book-open" aria-hidden="true"></i>
							<p class="mb-0">Les livrets seront bientôt disponibles.</p>
						</div>
					{% endif %}
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="join-grid">
				<a class="join-card red" href="{{ path('hebergement') }}">
					<i class="fa fa-bed big" aria-hidden="true"></i>
					<h3>Besoin d'un toit en arrivant ?</h3>
					<p>Faites une demande d'hébergement temporaire auprès des membres de l'association.</p>
					<span class="link-arrow">{{ parametres.menu_hebergement|default('Hébergement') }} <i class="fa fa-arrow-right" aria-hidden="true"></i></span>
				</a>
				<a class="join-card yellow" href="{{ path('app_faq') }}">
					<i class="fa fa-question-circle big" aria-hidden="true"></i>
					<h3>Une question précise ?</h3>
					<p>Titre de séjour, CAF, mutuelle, banque, job étudiant : consultez la FAQ.</p>
					<span class="link-arrow">Questions fréquentes <i class="fa fa-arrow-right" aria-hidden="true"></i></span>
				</a>
				<a class="join-card green" href="{{ path('app_contact') }}">
					<i class="fa fa-comments big" aria-hidden="true"></i>
					<h3>Parler à quelqu'un</h3>
					<p>Un·e bénévole de l'AG35 vous répond et vous oriente.</p>
					<span class="link-arrow">Nous écrire <i class="fa fa-arrow-right" aria-hidden="true"></i></span>
				</a>
			</div>
		</div>
	</section>
{% endblock %}
