{% extends 'base.html.twig' %}

{# Images du diaporama : les trois visuels de la première entrée MesImage #}
{% set slides = [] %}
{% if images|length > 0 %}
	{% set img = images|first %}
	{% for name in [img.imageName2, img.imageName3, img.imageName4] %}
		{% if name %}{% set slides = slides|merge([name]) %}{% endif %}
	{% endfor %}
{% endif %}

{# Vidéo de présentation : paramètre "lien_presentation_youtube" s'il existe #}
{% set video_url = parametres.lien_presentation_youtube|default('https://www.youtube-nocookie.com/embed/uhm9nODb8AA') %}

{% block body %}

	<!-- Hero -->
	<section class="hero">
		<div class="container">
			<div class="row align-items-center g-5">
				<div class="col-lg-6">
					<span class="eyebrow">{{ parametres.site_name|default('AG35') }} · Rennes</span>
					<h1 class="hero-title">{{ parametres.nom_association }}</h1>
					<p class="hero-lead">
						Accueillir, accompagner et rassembler la communauté guinéenne d'Ille-et-Vilaine :
						étudiant·es, familles et ami·es de la Guinée.
					</p>
					<div class="hero-ctas">
						<a href="{{ path('app_adhesion') }}" class="btn btn-primary">
							Adhérer à l'association <i class="fa fa-arrow-right ms-1" aria-hidden="true"></i>
						</a>
						<a href="{{ lien_don }}" target="_blank" rel="noopener" class="btn btn-ag-yellow">
							<i class="fa fa-heart me-1" aria-hidden="true"></i> Faire un don
						</a>
					</div>
					<div class="hero-meta">
						{% if parametres.address %}
							<span><i class="fa fa-map-marker-alt" aria-hidden="true"></i>{{ parametres.address }}</span>
						{% endif %}
						{% if parametres.lien_whatsApp %}
							<span><i class="fab fa-whatsapp" aria-hidden="true"></i><a href="{{ parametres.lien_whatsApp }}" target="_blank" rel="noopener">Rejoindre le groupe WhatsApp</a></span>
						{% endif %}
					</div>
				</div>

				<div class="col-lg-6">
					<div class="hero-media-wrap">
						<div class="hero-media">
							{% if slides|length > 1 %}
								<div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="5000">
									<div class="carousel-indicators">
										{% for s in slides %}
											<button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="{{ loop.index0 }}" {{ loop.first ? 'class="active" aria-current="true"' }} aria-label="Image {{ loop.index }}"></button>
										{% endfor %}
									</div>
									<div class="carousel-inner">
										{% for s in slides %}
											<div class="carousel-item {{ loop.first ? 'active' }}">
												<img src="{{ asset('img/' ~ s) }}" alt="Vie de l'association AG35" {{ loop.first ? 'fetchpriority="high"' : 'loading="lazy"' }}>
											</div>
										{% endfor %}
									</div>
								</div>
							{% elseif slides|length == 1 %}
								<img src="{{ asset('img/' ~ slides|first) }}" alt="Vie de l'association AG35" fetchpriority="high">
							{% else %}
								<img src="{{ asset('img/about.jpg') }}" alt="Vie de l'association AG35" fetchpriority="high">
							{% endif %}
						</div>
						<div class="hero-badge">
							<img src="{{ asset('img/guinea.png') }}" alt="">
							<div>
								<strong>Communauté guinéenne</strong>
								<small>d'Ille-et-Vilaine</small>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Prochain événement -->
	{% set prochain = evenements_a_venir|first %}
	{% if prochain %}
		{% set mois_longs = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'] %}
		{% set jours = ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'] %}
		{% set debut = prochain.dateDebut %}
		{% set ecart = ((debut|date('Y-m-d')|date('U') - 'today'|date('U')) / 86400)|round %}
		{% if debut|date('U') <= 'now'|date('U') %}
			{% set quand = 'En ce moment' %}
		{% elseif ecart == 0 %}
			{% set quand = 'Aujourd\'hui' %}
		{% elseif ecart == 1 %}
			{% set quand = 'Demain' %}
		{% else %}
			{% set quand = 'Dans ' ~ ecart ~ ' jours' %}
		{% endif %}
		<section class="next-event-wrap" aria-labelledby="titre-prochain">
			<div class="container">
				<div class="next-event">
					<div class="next-event-date" aria-hidden="true">
						<span class="d">{{ debut|date('d') }}</span>
						<span class="m">{{ ['jan', 'fév', 'mars', 'avr', 'mai', 'juin', 'juil', 'août', 'sept', 'oct', 'nov', 'déc'][debut|date('n') - 1] }}</span>
					</div>
					<div class="next-event-body">
						<span class="next-event-tag"><i class="fa fa-bell" aria-hidden="true"></i> Prochain événement · {{ quand }}</span>
						<h2 id="titre-prochain">{{ prochain.titre }}</h2>
						<p class="next-event-meta">
							<span><i class="fa fa-calendar-alt" aria-hidden="true"></i>{{ jours[debut|date('w')]|capitalize }} {{ debut|date('j') }} {{ mois_longs[debut|date('n') - 1] }} {{ debut|date('Y') }} à {{ debut|date('G\\hi') }}</span>
							{% if prochain.adresse %}<span><i class="fa fa-map-marker-alt" aria-hidden="true"></i>{{ prochain.adresse }}</span>{% endif %}
							{% if prochain.prix %}<span><i class="fa fa-ticket-alt" aria-hidden="true"></i>{{ prochain.prix matches '/^\\d+$/' ? prochain.prix ~ ' €' : prochain.prix }}</span>{% endif %}
						</p>
					</div>
					<div class="next-event-ctas">
						{% if prochain.lienBilleterie %}
							<a href="{{ prochain.lienBilleterie }}" class="btn btn-ag-yellow" target="_blank" rel="noopener"><i class="fa fa-ticket-alt me-1" aria-hidden="true"></i> Réserver</a>
						{% endif %}
						<a href="{{ path('app_evenement_details', {id: prochain.id}) }}" class="btn {{ prochain.lienBilleterie ? 'btn-ag-ghost' : 'btn-ag-yellow' }}">Voir le détail</a>
					</div>
				</div>
			</div>
		</section>
	{% endif %}

	<!-- Services -->
	{% if services|length > 0 %}
		<section class="section section-white" aria-labelledby="titre-services">
			<div class="container">
				<div class="section-head">
					<span class="eyebrow">Ce que nous faisons</span>
					<h2 class="section-title" id="titre-services">Nos services</h2>
					<p class="section-lead">Un accompagnement concret, de l'arrivée en France jusqu'à la vie associative.</p>
				</div>
				<div class="row row-cols-1 row-cols-md-2 row-cols-lg-{{ services|length == 4 ? 4 : 3 }} g-4">
					{% for service in services %}
						<div class="col">
							<article class="service-card">
								<div class="service-icon">
									{% if service.imageName %}
										<img src="{{ asset('img/' ~ service.imageName) }}" alt="">
									{% else %}
										<i class="fa fa-hands-helping text-primary" aria-hidden="true"></i>
									{% endif %}
								</div>
								<h3>{{ service.titre }}</h3>
								<p>{{ service.descriptif }}</p>
							</article>
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}

	<!-- Vidéo de présentation -->
	<section class="section" aria-labelledby="titre-video">
		<div class="container">
			<div class="video-block">
				<div class="row g-0 align-items-stretch">
					<div class="col-lg-5 d-flex align-items-center">
						<div class="video-text">
							<span class="eyebrow">L'AG35 en images</span>
							<h2 id="titre-video" class="mb-3">Fête de l'indépendance 2026</h2>
							<p class="mb-4">Revivez la fête de l'indépendance de la Guinée organisée par l'AG35 à Rennes : musique, culture et convivialité, toute la communauté réunie.</p>
							<div class="d-flex flex-wrap gap-2">
								<a href="{{ path('app_evenements') }}" class="btn btn-ag-yellow">Nos prochains événements</a>
								<a href="{{ path('app_about') }}" class="btn btn-ag-ghost">Qui sommes-nous ?</a>
							</div>
						</div>
					</div>
					<div class="col-lg-7">
						<div class="ratio ratio-16x9">
							<iframe src="{{ video_url }}" title="Fête de l'indépendance de la Guinée 2026 à Rennes, organisée par l'AG35" loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Événements -->
	{# Le prochain événement est déjà dans le bandeau : on affiche les suivants, puis les plus récents passés #}
	{% set agenda = evenements_a_venir|slice(1)|merge(evenements_passes)|slice(0, 3) %}
	{% if agenda|length > 0 %}
		<section class="section section-white" aria-labelledby="titre-events">
			<div class="container">
				<div class="section-head-row">
					<div class="section-head">
						<span class="eyebrow">Agenda</span>
						<h2 class="section-title" id="titre-events">{{ evenements_a_venir|length > 1 ? 'Au programme' : parametres.accueil_event|default('Nos derniers événements') }}</h2>
					</div>
					<a href="{{ path('app_evenements') }}" class="link-arrow">Tous les événements <i class="fa fa-arrow-right" aria-hidden="true"></i></a>
				</div>
				<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
					{% for evenement in agenda %}
						<div class="col">
							{% include 'components/event_card.html.twig' with {passe: evenement in evenements_passes} %}
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}

	<!-- Actualités -->
	{% if actualites|length > 0 %}
		{% set mois_actu = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'] %}
		<section class="section" aria-labelledby="titre-actus">
			<div class="container">
				<div class="section-head-row">
					<div class="section-head">
						<span class="eyebrow">La vie de l'association</span>
						<h2 class="section-title" id="titre-actus">Dernières actualités</h2>
					</div>
					<a href="{{ path('app_actualites') }}" class="link-arrow">Toutes les actualités <i class="fa fa-arrow-right" aria-hidden="true"></i></a>
				</div>
				<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
					{% for actualite in actualites %}
						<div class="col">
							<article class="news-card">
								<div class="news-media">
									{% if actualite.imageName %}
										<img src="{{ asset('img/' ~ actualite.imageName) }}" alt="" loading="lazy" onerror="this.remove()">
									{% endif %}
								</div>
								<div class="news-body">
									{% if actualite.datePublication %}
										<time class="news-date" datetime="{{ actualite.datePublication|date('Y-m-d') }}">
											{{ actualite.datePublication|date('j') }} {{ mois_actu[actualite.datePublication|date('n') - 1] }} {{ actualite.datePublication|date('Y') }}
										</time>
									{% endif %}
									<h3>{{ actualite.titre }}</h3>
									{% set resume = actualite.description|striptags|trim %}
									<p>{{ resume|length > 160 ? resume|slice(0, 157)|trim ~ '…' : resume }}</p>
									<a href="{{ path('app_actualites') }}" class="link-arrow mt-auto pt-2">Lire <i class="fa fa-arrow-right" aria-hidden="true"></i></a>
								</div>
							</article>
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}

	<!-- Témoignages -->
	{% if temoins|length > 0 %}
		<section class="section" aria-labelledby="titre-temoins">
			<div class="container">
				<div class="section-head center">
					<span class="eyebrow">Témoignages</span>
					<h2 class="section-title" id="titre-temoins">{{ parametres.accueil_temoin|default('Ils parlent de nous') }}</h2>
				</div>
				<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 justify-content-center">
					{% for temoin in temoins %}
						<div class="col">
							<figure class="quote-card m-0">
								<blockquote>{{ temoin.descriptif }}</blockquote>
								<figcaption class="quote-author">
									{% if temoin.imageName %}
										<img src="{{ asset('img/' ~ temoin.imageName) }}" alt="" loading="lazy">
									{% else %}
										<span class="avatar-initials" aria-hidden="true">{% for part in temoin.nom|split(' ')|slice(0, 2) %}{{ part|first|upper }}{% endfor %}</span>
									{% endif %}
									<div>
										<strong>{{ temoin.nom }}</strong>
										<span>{{ temoin.fonction }}</span>
									</div>
								</figcaption>
							</figure>
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}

	<!-- Partenaires -->
	{% if partenaires|length > 0 %}
		<section class="section-sm partners-band" aria-labelledby="titre-partenaires">
			<div class="container">
				<p class="partners-title" id="titre-partenaires">Ils nous soutiennent</p>
				<div class="partners">
					{% for partenaire in partenaires %}
						<div class="partner">
							<img src="{{ asset('img/' ~ partenaire.imageName) }}" alt="Logo partenaire" loading="lazy">
						</div>
					{% endfor %}
				</div>
				<p class="text-center mt-4 mb-0"><a class="link-arrow" href="{{ path('app_contact') }}">Devenir partenaire <i class="fa fa-arrow-right" aria-hidden="true"></i></a></p>
			</div>
		</section>
	{% endif %}

	<!-- Rejoindre -->
	<section class="section section-white" aria-labelledby="titre-rejoindre">
		<div class="container">
			<div class="section-head center">
				<span class="eyebrow">S'engager</span>
				<h2 class="section-title" id="titre-rejoindre">Rejoignez l'aventure</h2>
				<p class="section-lead">Il y a mille façons de faire vivre l'association. Choisissez la vôtre.</p>
			</div>
			<div class="join-grid">
				<a class="join-card green" href="{{ path('app_adhesion') }}">
					<i class="fa fa-id-card big" aria-hidden="true"></i>
					<h3>Devenir membre</h3>
					<p>Adhérez pour participer aux décisions et à la vie de l'association.</p>
					<span class="link-arrow">{{ parametres.menu_adhesion }} <i class="fa fa-arrow-right" aria-hidden="true"></i></span>
				</a>
				<a class="join-card yellow" href="{{ path('app_volontariat') }}">
					<i class="fa fa-hands-helping big" aria-hidden="true"></i>
					<h3>Être bénévole</h3>
					<p>Donnez un peu de votre temps lors de nos événements et actions.</p>
					<span class="link-arrow">{{ parametres.menu_volontariat }} <i class="fa fa-arrow-right" aria-hidden="true"></i></span>
				</a>
				<a class="join-card red" href="{{ path('hebergement') }}">
					<i class="fa fa-home big" aria-hidden="true"></i>
					<h3>Trouver un logement</h3>
					<p>Nouvel·le étudiant·e ? Faites une demande d'hébergement temporaire.</p>
					<span class="link-arrow">{{ parametres.menu_hebergement }} <i class="fa fa-arrow-right" aria-hidden="true"></i></span>
				</a>
			</div>
		</div>
	</section>

{% endblock %}
