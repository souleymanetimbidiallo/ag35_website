{% extends 'base.html.twig' %}

{% block title %}Formulaire de Volontariat{% endblock %}

{% block body %}
<div class="container">
    <h1 class="mt-5 mb-4">Formulaire pour être volontaire</h1>
    <div class="row">
        <div class="col-md-6">
            {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}
            
            <div class="mb-3">
                {{ form_row(form.nom, {'label': 'Nom', 'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="mb-3">
                {{ form_row(form.prenom, {'label': 'Prénom', 'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="mb-3">
               {{ form_row(form.email) }}
            </div>
            <div class="mb-3">
                {{ form_row(form.telephone, {'label': 'Téléphone', 'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="mb-3">
                {{ form_row(form.motivation, {'label': 'Motivation', 'attr': {'class': 'form-control'}}) }}
            </div>
              
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Enregistrer</button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
    {% for message in app.flashes('success') %}
    <div class="alert alert-success">
        {{ message }}
    </div>
{% endfor %}
</div>
{% endblock %}
