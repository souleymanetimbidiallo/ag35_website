{# templates/envoyermail.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Envoyer Newsletter{% endblock %}

{% block body %}
    <h1>Envoyer Newsletter</h1>
    <form method="post" action="{{ path('envoyer_newsletter') }}" enctype="multipart/form-data">
        {# Champ pour le sujet du mail #}
        <label for="sujet">Sujet du mail :</label>
        <input type="text" id="sujet" name="sujet" class="form-control" required>

        {# Champ pour le contenu du mail #}
        <label for="contenu">Contenu du mail :</label>
        <textarea id="contenu" name="contenu" class="form-control" required></textarea>

        {# Champ pour l'ajout d'une pièce jointe #}
        <label for="piece_jointe">Pièce jointe :</label>
        <input type="file" id="piece_jointe" name="piece_jointe" class="form-control">

        {# Bouton pour envoyer la newsletter #}
        <button type="submit">Envoyer</button>
    </form>
{% endblock %}
