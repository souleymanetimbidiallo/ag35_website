{% extends 'base.html.twig' %}

{% block title %}Envoyer la newsletter · {{ parent() }}{% endblock %}

{% block meta_tags %}
    <meta name="robots" content="noindex">
{% endblock %}

{% block body %}
    {% include 'components/page_hero.html.twig' with {
        title: 'Envoyer la newsletter',
        eyebrow: 'Administration',
        lead: 'Rédigez un message et choisissez les listes de diffusion destinataires.'
    } %}

    <section class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="form-card">
                <form method="post" action="{{ path('envoyer_newsletter') }}" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="categorie" class="form-label">Catégorie :</label>
                        <select id="categorie" name="categorie" class="form-select" required>
                            <option value="" disabled selected>Choisir une catégorie</option>
                            {% for categorie in categories %}
                                <option value="{{ categorie.id }}">{{ categorie.subject }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    
                    <div class="mb-3">
                        <label for="sujet" class="form-label">Sujet du mail :</label>
                        <input type="text" id="sujet" name="sujet" class="form-control" required>
                    </div>

                    <div class="mb-3">
                        <label for="contenu" class="form-label">Contenu du mail :</label>
                        <textarea id="contenu" name="contenu" class="form-control" rows="8" required></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="piece_jointe" class="form-label">Pièce jointe :</label>
                        <input type="file" id="piece_jointe" name="piece_jointe" class="form-control">
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Liste de diffusion :</label>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="newsletter" name="liste_diffusion[]" value="newsletter">
                            <label class="form-check-label" for="newsletter">Newsletter</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="adherants" name="liste_diffusion[]" value="adherants">
                            <label class="form-check-label" for="adherants">Adhérent·es</label>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-3 align-items-center">
                        <button type="submit" class="btn btn-primary"><i class="fa fa-paper-plane me-1" aria-hidden="true"></i> Envoyer</button>
                        <a class="link-arrow" href="{{ path('admin') }}"><i class="fa fa-arrow-left" aria-hidden="true"></i> Retour à l'administration</a>
                    </div>
                </form>
                </div>
            </div>
        </div>
    </div>
    </section>
{% endblock %}
