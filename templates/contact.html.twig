{% extends 'base.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block body %}


	<!-- Page Header Start -->
	{% for image in images %}
		<div class="container-fluid py-5 mb-5 wow" data-wow-delay="0.1s" style="background-image: url('{{ asset('img/ag35/' ~ image.imageName8) }}'); background-size: cover; background-position: center; min-height: 100vh;">
			<div class="container text-center py-5">
				<h1 class="display-2 text-white mb-4 animated slideInDown">Contactez-nous</h1>
			</div>
		</div>
	{% endfor %}
	<!-- Page Header End -->


	<!-- Contact Start -->
	<div class="container-xxl py-5">
		<div class="container">
			<div class="text-center mx-auto wow fadeInUp" data-wow-delay="0.1s" style="max-width: 500px;">

	<div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s">
		<div class="container text-center py-5">
			<h1 class="display-2 text-white mb-4 animated slideInDown">Contactez-nous</h1>
		</div>
	</div>
	<!-- Page Header End -->


	<!-- Contact Start -->
	<div class="container-xxl py-5">
		<div class="container">
			<div class="text-center mx-auto wow fadeInUp" data-wow-delay="0.1s" style="max-width: 500px;">

				<h1 class="display-5 mb-5">Si vous avez des questions, veuillez nous contacter</h1>
			</div>
			<div class="row g-5">
				<div class="col-lg-6 wow fadeInUp" data-wow-delay="0.1s">
					{% for message in app.flashes('success') %}
						<div class="alert alert-success mt-4">
							{{ message }}
						</div>
					{% endfor %}

					{{ form_start(form) }}
					<div class="row g-3">
						<div class="col-12">
							{{ form_row(form.prenom, {'attr': {'class': 'form-control', 'placeholder': 'Entrez votre prénom'}}) }}
						</div>
						<div class="col-12">
							{{ form_row(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Entrez votre nom'}}) }}
						</div>
						<div class="col-12">
							{{ form_row(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Email'}}) }}
						</div>
						<div class="col-12">
							{{ form_row(form.telephone, {'attr': {'class': 'form-control', 'placeholder': 'Téléphone'}}) }}
						</div>
						<div class="col-12">
							{{ form_row(form.titre, {'attr': {'class': 'form-control'}}) }}
						</div>
						<div class="col-12">
							{{ form_row(form.message, {'attr': {'class': 'form-control', 'placeholder': 'Ecrire votre message ici', 'style': 'height: 200px'}}) }}
						</div>
						<div class="col-12">
							{{ form_row(form.submit, {'attr': {'class': 'btn btn-primary rounded-pill py-3 px-5'}}) }}
						</div>
					</div>
					{{ form_end(form) }}
				</div>
				<div class="col-lg-6 wow fadeInUp" data-wow-delay="0.5s">
					<h3 class="mb-4">Details du contact</h3>
					<div class="d-flex border-bottom pb-3 mb-3"></div>
					<div class="col-lg-6 wow fadeInUp" data-wow-delay="0.5s">
						<div class="d-flex border-bottom pb-3 mb-3">
							<div class="flex-shrink-0 btn-square bg-primary rounded-circle">
								<i class="fa fa-map-marker-alt text-white"></i>
							</div>
							<div class="ms-3">
								<h6>Notre bureau</h6>
								<span>{{ parametres.address }}</span>
							</div>
						</div>
						<div class="d-flex border-bottom pb-3 mb-3">
							<div class="flex-shrink-0 btn-square bg-primary rounded-circle">
								<i class="fa fa-phone-alt text-white"></i>
							</div>
							<div class="ms-3">
								<h6>Appelez-nous</h6>
								<a href="tel:assoguinee35@gmail.com">{{ parametres.telephone }}</a>
							</div>
						</div>
						<div class="d-flex border-bottom-0 pb-3 mb-3">
							<div class="flex-shrink-0 btn-square bg-primary rounded-circle">
								<i class="fa fa-envelope text-white"></i>
							</div>
							<div class="ms-3">
								<h6>Envoyez-nous un e-mail</h6>
								<a href="mailto:assoguinee35@gmail.com">{{ parametres.email }}</a>
							</div>
						</div>
					</div>
					<iframe class="w-100 rounded" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2663.932086270552!2d-1.6566053!3d48.1115458!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x480ede544566a8b9%3A0xbd862df6dd010552!2s40%20Bd%20Jeanne%20d&#39;Arc%2C%2035000%20Rennes!5e0!3m2!1sfr!2sfr!4v1686229382401!5m2!1sfr!2sfr" frameborder="0" style="min-height: 300px; border:0;" allowfullscreen="" aria-hidden="false" tabindex="0"></iframe>


				</div>
			</div>
		</div>
	</div>
	<!-- Contact End -->
{% endblock %}
