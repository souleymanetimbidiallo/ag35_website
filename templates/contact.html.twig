{% extends 'base.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}Contact · {{ parent() }}{% endblock %}

{% set row = {row_attr: {class: 'mb-3'}, label_attr: {class: 'form-label'}} %}

{% block body %}
	{% include 'components/page_hero.html.twig' with {
		title: parametres.menu_contact|default('Contact'),
		eyebrow: 'Écrivez-nous',
		lead: 'Une question, une demande d\'aide ou envie de vous engager ? Notre équipe vous répond au plus vite.'
	} %}

	<section class="section">
		<div class="container">
			<div class="row g-5">
				<div class="col-lg-7">
					<div class="form-card">
						<h2 class="h4 mb-1">Envoyer un message</h2>
						<p class="text-muted-ag mb-4">Tous les champs sont obligatoires.</p>

						<div id="message" style="display: none;" class="alert-ag mb-4" role="status">
							<i class="fa fa-check-circle mt-1" aria-hidden="true"></i>
							<span>Merci, nous avons bien reçu votre message. Nous vous répondrons dans les plus brefs délais.</span>
						</div>

						{{ form_start(form) }}
							<div class="row g-0 gx-3">
								<div class="col-md-6">{{ form_row(form.prenom, row|merge({attr: {class: 'form-control', placeholder: 'Votre prénom', autocomplete: 'given-name'}})) }}</div>
								<div class="col-md-6">{{ form_row(form.nom, row|merge({attr: {class: 'form-control', placeholder: 'Votre nom', autocomplete: 'family-name'}})) }}</div>
								<div class="col-md-6">{{ form_row(form.email, row|merge({attr: {class: 'form-control', placeholder: 'vous@exemple.fr', autocomplete: 'email'}})) }}</div>
								<div class="col-md-6">{{ form_row(form.telephone, row|merge({attr: {class: 'form-control', placeholder: '06 12 34 56 78', autocomplete: 'tel'}})) }}</div>
								<div class="col-12">{{ form_row(form.titre, row|merge({label: 'Sujet de votre demande', attr: {class: 'form-select'}})) }}</div>
								<div class="col-12">{{ form_row(form.message, row|merge({attr: {class: 'form-control', placeholder: 'Écrivez votre message ici…', rows: 6}})) }}</div>
								<div class="col-12 mt-2">{{ form_row(form.submit, {label: 'Envoyer le message', attr: {class: 'btn btn-primary px-4'}}) }}</div>
							</div>
						{{ form_end(form) }}
					</div>
				</div>

				<div class="col-lg-5">
					<h2 class="h4 mb-2">Nos coordonnées</h2>
					<p class="text-muted-ag">Vous pouvez aussi nous joindre directement ou passer nous voir.</p>

					{% if parametres.address %}
						<div class="contact-item">
							<span class="ico"><i class="fa fa-map-marker-alt" aria-hidden="true"></i></span>
							<div><small>Adresse</small><span>{{ parametres.address }}</span></div>
						</div>
					{% endif %}
					{% if parametres.telephone %}
						<div class="contact-item">
							<span class="ico"><i class="fa fa-phone-alt" aria-hidden="true"></i></span>
							<div><small>Téléphone</small><a href="tel:{{ parametres.telephone|replace({' ': ''}) }}">{{ parametres.telephone }}</a></div>
						</div>
					{% endif %}
					{% if parametres.email %}
						<div class="contact-item">
							<span class="ico"><i class="fa fa-envelope" aria-hidden="true"></i></span>
							<div><small>E-mail</small><a href="mailto:{{ parametres.email }}">{{ parametres.email }}</a></div>
						</div>
					{% endif %}
					{% if parametres.lien_whatsApp %}
						<div class="contact-item">
							<span class="ico"><i class="fab fa-whatsapp" aria-hidden="true"></i></span>
							<div><small>Communauté</small><a href="{{ parametres.lien_whatsApp }}" target="_blank" rel="noopener">Rejoindre le groupe WhatsApp</a></div>
						</div>
					{% endif %}

					{% if parametres.address %}
						<div class="map-frame mt-4">
							<iframe src="https://maps.google.com/maps?q={{ parametres.address|url_encode }}&output=embed" title="Plan d'accès" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
						</div>
					{% endif %}
				</div>
			</div>
		</div>
	</section>
{% endblock %}
