{% extends 'base.html.twig' %}

{% block title %}À propos · {{ parent() }}{% endblock %}

{% block body %}
	{% include 'components/page_hero.html.twig' with {
		title: 'À propos',
		eyebrow: parametres.nous_sommes|default('Nous sommes'),
		lead: parametres.nom_association ~ ', une association d\'entraide et de culture au service de la communauté guinéenne de Rennes et d\'Ille-et-Vilaine.'
	} %}

	{# Qui sommes-nous #}
	<section class="section">
		<div class="container">
			<div class="row g-5 align-items-center">
				<div class="col-lg-6">
					<div class="about-media">
						<img src="{{ asset('img/fond3.jpeg') }}" alt="Membres de l'AG35 réunis" loading="lazy">
					</div>
				</div>
				<div class="col-lg-6">
					<span class="eyebrow">Notre mission</span>
					<h2 class="section-title">Accueillir, accompagner, rassembler</h2>
					{% set points = parametres.texte_about|default('')|split(';')|filter(p => p|trim is not empty) %}
					{% if points|length > 0 %}
						<ul class="check-list mt-4">
							{% for point in points %}
								<li>{{ point|trim|striptags }}</li>
							{% endfor %}
						</ul>
					{% else %}
						<p class="section-lead">Le texte de présentation se renseigne dans l'administration (texte « texte_about »).</p>
					{% endif %}
					<div class="d-flex flex-wrap gap-2 mt-4">
						<a href="{{ path('app_adhesion') }}" class="btn btn-primary">Devenir membre</a>
						<a href="{{ path('app_contact') }}" class="btn btn-ag-ghost">Nous contacter</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	{# Valeurs #}
	{% if valeurs|length > 0 %}
		<section class="section section-white" aria-labelledby="titre-valeurs">
			<div class="container">
				<div class="section-head center">
					<span class="eyebrow">Ce qui nous guide</span>
					<h2 class="section-title" id="titre-valeurs">{{ parametres.nos_valeurs|default('Nos valeurs') }}</h2>
					<p class="section-lead">{{ parametres.texte_nos_valeurs }}</p>
				</div>
				<div class="row row-cols-1 row-cols-md-2 row-cols-lg-{{ valeurs|length == 4 ? 4 : 3 }} g-4">
					{% for valeur in valeurs %}
						<div class="col">
							<article class="card-ag value-card">
								<span class="value-num" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span>
								<h3>{{ valeur.titre|replace({(loop.index ~ ') '): ''}) }}</h3>
								<p class="text-muted-ag">{{ valeur.descriptif|striptags }}</p>
							</article>
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}

	{# Bureau #}
	{% if bureau|length > 0 %}
		<section class="section" aria-labelledby="titre-bureau">
			<div class="container">
				<div class="section-head center">
					<span class="eyebrow">L'équipe</span>
					<h2 class="section-title" id="titre-bureau">{{ parametres.nos_gouvernances|default('Gouvernance & Bureau') }}</h2>
					<p class="section-lead">{{ parametres.texte_nos_gouvernances }}</p>
				</div>
				<div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4 justify-content-center">
					{% for membre in bureau %}
						<div class="col">
							<article class="card-ag team-card">
								{% if membre.imageName %}
									<img class="team-photo" src="{{ asset('img/' ~ membre.imageName) }}" alt="Photo de {{ membre.prenom }} {{ membre.nom }}" loading="lazy">
								{% else %}
									<span class="team-photo avatar-initials" aria-hidden="true">{{ membre.prenom|first|upper }}{{ membre.nom|first|upper }}</span>
								{% endif %}
								<h3>{{ membre.prenom }} {{ membre.nom|capitalize }}</h3>
								{% if membre.fonction %}<span class="team-role">{{ membre.fonction }}</span>{% endif %}
							</article>
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}

	{# Partenaires #}
	{% if partenaires is not null and partenaires|length > 0 %}
		<section class="section section-white" aria-labelledby="titre-partenaires">
			<div class="container">
				<div class="section-head center">
					<span class="eyebrow">Ils nous soutiennent</span>
					<h2 class="section-title" id="titre-partenaires">{{ parametres.nos_partenaires|default('Partenaires') }}</h2>
					<p class="section-lead">{{ parametres.texte_nos_partenaires }}</p>
				</div>
				<div class="partners">
					{% for partenaire in partenaires %}
						<div class="partner">
							<img src="{{ asset('img/' ~ partenaire.imageName) }}" alt="Logo partenaire" loading="lazy">
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}
{% endblock %}
