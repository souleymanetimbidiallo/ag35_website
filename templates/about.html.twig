{% extends 'base.html.twig' %}

{% block body %}
	<!-- Page Header Start -->

	{% for image in images  %}

		<div class="container-fluid py-5 mb-5 wow" data-wow-delay="0.1s" style="background-image: url('{{ asset('img/' ~ image.imageName8) }}'); background-size: cover; background-position: center; min-height: 100vh;">

			<div class="container text-center py-5">

				<h1 class="display-2 text-white mb-4 animated slideInDown">A propos</h1>

			</div>

		</div>

	{% endfor %}

	<!-- Page Header End -->


	<!-- About Start -->

	<div class="container">
		<div class="row g-0">
			<div class="col-lg-6">
				<div class="h-100 d-flex align-items-center justify-content-center" style="min-height: 300px;">
					{% for image in images %}
						<img src="{{ asset('img/' ~ image.imageName7) }}" class="img-fluid" alt="About Image">
					{% endfor %}
				</div>
			</div>
			<div class="col-lg-6 pt-lg-5 wow fadeIn" data-wow-delay="0.5s">
				<div class="bg-white rounded-top p-5 mt-lg-5">
					<p class="fs-5 fw-medium text-primary">{{ parametres.nous_sommes }}</p>
					<h1 class="display-6 mb-4">{{ parametres.nom_association }}</h1>
					<ul class="mb-4">
						{% set points = parametres.texte_about|split(';') %}
						{% for point in points %}
							{% if point|trim is not empty %}
								<li>{{ point|trim }}</li>
							{% endif %}
						{% endfor %}
					</ul>
				</li>
			</ul>
		</div>
	</div>
</div></div><!-- About End --><!-- Nos Valeurs --><div class="container bg-light my-5 py-5">
<div class="row">
	<div class="col-12 text-center">
		<h2 class="text-primary">{{parametres.nos_valeurs}}</h2>
		<p>{{ parametres.texte_nos_valeurs }}</p>
	</div>
</div>
<div class="row mt-5">
	{% for valeur in valeurs %}
		<div class="col-lg-4 col-md-6">
			<div class="card mb-3">
				<div class="card-body">
					<h4 class="card-title text-primary">{{ valeur.titre }}</h4>
					<p class="card-text">{{ valeur.descriptif }}</p>
				</div>
			</div>
		</div>
	{% endfor %}
</div></div><!-- Nos Valeurs End --><!-- Team Start --><div class="container bg-light my-5 py-5">
<div class="row">
	<div class="col-12 text-center">
		<h2 class="text-primary">{{parametres.nos_gouvernances}}</h2>
		<p>{{parametres.texte_nos_gouvernances}}</p>
	</div>
</div>
<div class="container-xxl py-5">
	<div class="container">
		<div class="row g-4">
			{% for mBureau in bureau %}
				<div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay="0.1s" style="height: 350px;">
					<div class="team-item rounded overflow-hidden pb-4" style="height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center;">
						<img class="img-fluid mb-4" src="{{ asset('img/' ~ mBureau.imageName) }}" alt="Photo" style="object-fit: cover; width: auto; height: 75%; max-width: 100%;">
						<h5>{{ mBureau.prenom }}
							{{ mBureau.nom }}</h5>
						<span class="text-primary">{{ mBureau.fonction }}</span>
					</div>
				</div>
			{% endfor %}
		</div>
	</div>
</div></div><!-- Team End --><!-- Partenaires et Sponsors --><div class="container bg-light my-5 py-5">
<div class="row">
	<div class="col-12 text-center">
		<h2 class="text-primary">{{ parametres.nos_partenaires }}</h2>
		<p>{{ parametres.texte_nos_partenaires }}</p>
	</div>
</div>
<div class="row justify-content-center">
	<div class="col-12 partner-logos">
		<div class="d-flex justify-content-between align-items-center">
			{% if partenaires is not null %}
				{% for partenaire in partenaires %}
					<div class="partner-logo"><img src="{{ asset('img/' ~ partenaire.imageName) }}" alt="logo-partner-1" style="max-width: 150px; max-height: 150px;"></div>
				{% endfor %}
			{% endif %}
		</div>
	</div>
</div></div><!-- Partenaires et Sponsors End -->{% endblock %}
