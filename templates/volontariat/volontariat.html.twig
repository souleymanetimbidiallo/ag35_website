{% extends 'base.html.twig' %}

{% block title %}Liste des Activités{% endblock %}

{% block body %}
<div class="container-xxl pt-5">
    <div class="container">
        <div class="text-center text-md-start pb-5 pb-md-0 wow fadeInUp" style="max-width: 500px;">
            <p class="fs-5 fw-medium text-primary">Les volontariats</p>
            <h1 class="display-5 mb-5">Nos opportunités de volontariat</h1>
        </div>
        <div class="row row-cols-1 row-cols-md-2 g-4">
            {% for volontariat in volontariats %}
            <div class="col">
                <div class="card h-100">
                   
                    <div class="card-body">
                        <h5 class="card-title">{{ volontariat.titre }}</h5>
                        <p class="card-text">{{ volontariat.description }}</p>
                        <p class="card-text"><small class="text-muted">Lieu : {{ volontariat.lieu }}</small></p>
                        {% if volontariat.dateDebut is not null %}
                        <p class="card-text">Date de début : {{ volontariat.dateDebut|date('d/m/Y H:i') }}</p>
                        {% endif %}
                        {% if volontariat.dateFin is not null %}
                        <p class="card-text">Date de fin : {{ volontariat.dateFin|date('d/m/Y H:i') }}</p>
                        {% endif %}
                        <p>{{ "Voulez-vous être volontaire à cette activité ? Si oui " }}</p>
                <a href="{{ path('volontaire', {'id': volontariat.id}) }}" class="btn btn-primary">Cliquez ici</a>

                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
