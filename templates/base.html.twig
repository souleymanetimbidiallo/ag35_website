<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{% block title %}{{ parametres.site_name|default('AG35') }} · {{ parametres.nom_association|default('Association des Guinéen·nes d\'Ille-et-Vilaine') }}{% endblock %}</title>
		<meta name="description" content="{% block meta_description %}{{ parametres.nom_association|default('AG35') }} : entraide, accueil des étudiant·es, événements culturels et vie associative à Rennes.{% endblock %}">
		<meta name="theme-color" content="#0B3D2E">

		<link rel="icon" type="image/png" href="{{ asset('img/logo_ag35.png') }}">

		<!-- Polices -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

		<!-- Icônes -->
		<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
		<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

		<!-- Bibliothèques encore utilisées par les pages internes -->
		<link href="{{ asset('lib/animate/animate.min.css') }}" rel="stylesheet">
		<link href="{{ asset('lib/owlcarousel/assets/owl.carousel.min.css') }}" rel="stylesheet">
		<link href="{{ asset('lib/lightbox/css/lightbox.min.css') }}" rel="stylesheet">

		<link href="{{ asset('css/bootstrap.min.css') }}" rel="stylesheet">
		<link href="{{ asset('css/style.css') }}" rel="stylesheet">
		<!-- Charte AG35 : doit rester en dernier -->
		<link href="{{ asset('css/ag35.css') }}" rel="stylesheet">

		{% block meta_tags %}
			<meta property="og:type" content="website">
			<meta property="og:site_name" content="{{ parametres.site_name|default('AG35') }}">
			<meta property="og:title" content="{% block og_title %}{{ parametres.nom_association|default('AG35') }}{% endblock %}">
			<meta property="og:description" content="{% block og_description %}{% endblock %}">
			<meta property="og:url" content="{% block og_url %}{{ app.request.uri }}{% endblock %}">
			<meta property="og:image" content="{% block og_image %}{{ absolute_url(asset('img/logo_ag35.png')) }}{% endblock %}">
		{% endblock %}

		{% block stylesheets %}{% endblock %}
	</head>

	<body>
		<a class="skip-link" href="#contenu">Aller au contenu</a>

		{% include 'components/navbar.html.twig' %}

		<main id="contenu">
			{% block body %}{% endblock %}
		</main>

		{% include 'components/footer.html.twig' %}

		<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.1/jquery.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
		<script src="{{ asset('lib/wow/wow.min.js') }}"></script>
		<script src="{{ asset('lib/easing/easing.min.js') }}"></script>
		<script src="{{ asset('lib/waypoints/waypoints.min.js') }}"></script>
		<script src="{{ asset('lib/owlcarousel/owl.carousel.min.js') }}"></script>
		<script src="{{ asset('lib/lightbox/js/lightbox.min.js') }}"></script>
		<script src="{{ asset('js/main.js') }}"></script>
		{% block javascripts %}{% endblock %}
	</body>
</html>
