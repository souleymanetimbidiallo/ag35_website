{% extends 'base.html.twig' %}

{% block body %}
	<div
		class="container">
		<!-- Page Header Start -->

		<h1 class="display-2 text-dark mb-4 animated slideInDown">Devenez membre d’AG35</h1>
		{% set points = parametres.texte_adhesion|split('.') %}
		{% for point in points %}
			{% if point|trim is not empty %}
				<p>{{ point|trim }}</p>
			{% endif %}
		{% endfor %}
		<a class="btn btn-primary" target="_blank" href="{{ parametres.lien_adhesion }}">Adhérer</a>

	</div>
{% endblock %}
